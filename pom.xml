         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.serviciosintegrados</groupId>
    <artifactId>servicios-integrados</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>servicios-integrados</name>

    <modules>
        <module>microservicio-clientes</module>
        <module>microservicio-productos</module>
        <module>microservicio-inventario</module>
        <module>microservicio-ventas</module>
        <module>microservicio-facturacion</module>
    </modules>
